+//! Bifrost vendor — rolling-window AI usage aggregates (1d, 7d, 30d) from a
+//! self-hosted Bifrost gateway, fetched from `GET {base_url}/usage?period=Xd`
+//! and authenticated with the `x-bf-vk` request header. The 30-day window is
+//! the headline; every window renders as its own panel card.
+
+pub mod fetch;
+pub mod types;
+pub mod vendor;
+
+pub use fetch::{FetchOutcome, fetch_snapshot};
diff --git a/src/bifrost/types.rs b/src/bifrost/types.rs
new file mode 100644
index 0000000..32d3691
--- /dev/null
+++ b/src/bifrost/types.rs
@@ -0,0 +1,302 @@
+//! Bifrost usage response types and snapshot conversion.
+
+use chrono::{DateTime, Utc};
+use serde::{Deserialize, Serialize};
+
+use crate::error::{AppError, Result};
+use crate::usage::finite_amount;
+
+/// Rolling windows the panel renders, in display order. Every card requests
+/// the same endpoint — `{base_url}/usage?period=Xd` — with only the `period`
+/// query parameter changing.
+pub const PERIODS: [&str; 3] = ["1d", "7d", "30d"];
+
+/// Days in a rolling window, so a card's gauge can pace its spend against that
+/// window's share of the monthly budget (`budget × days / 30`). The 30-day
+/// window is the headline and reads the full budget directly.
+pub fn period_days(period: &str) -> f64 {
+    match period {
+        "1d" => 1.0,
+        "7d" => 7.0,
+        _ => 30.0,
+    }
+}
+
+/// Raw body returned by `{base_url}/usage?period=Xd`.
+#[derive(Debug, Clone, Deserialize)]
+pub struct UsageData {
+    pub key_name: String,
+    pub key_id: String,
+    pub period: String,
+    #[serde(rename = "data_since")]
+    pub data_since: String,
+    pub requests: u64,
+    pub tokens_in: u64,
+    pub tokens_out: u64,
+    pub cost_usd: f64,
+    pub models_used: u64,
+}
+
+/// One rolling window's parsed aggregate.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct WindowUsage {
+    pub period: String,
+    pub cost_usd: f64,
+    pub requests: u64,
+    pub tokens_in: u64,
+    pub tokens_out: u64,
+    pub models_used: u64,
+}
+
+impl WindowUsage {
+    pub fn parse(data: UsageData) -> Result<Self> {
+        Ok(Self {
+            period: data.period,
+            cost_usd: finite_amount("bifrost", "cost_usd", data.cost_usd)?,
+            requests: data.requests,
+            tokens_in: data.tokens_in,
+            tokens_out: data.tokens_out,
+            models_used: data.models_used,
+        })
+    }
+}
+
+/// A window that failed to fetch, kept so the panel can name the missing
+/// capsule rather than silently drawing two of the three.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct WindowError {
+    pub period: String,
+    pub error: String,
+}
+
+/// Parsed, machine-readable Bifrost snapshot surfaced to every frontend. The
+/// key identity comes from the 30-day read — the headline window — falling
+/// back to whichever window answered, while each rolling window carries its
+/// own aggregate.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct BifrostSnapshot {
+    pub key_name: String,
+    pub key_id: String,
+    /// `data_since` + 30 days — the rolling 30-day window reset. Only known
+    /// when the 30-day read succeeded; the shorter windows never reset.
+    pub reset_at: Option<DateTime<Utc>>,
+    /// Successful windows in display order (1d, 7d, 30d).
+    pub windows: Vec<WindowUsage>,
+    /// Windows that failed, in the same order.
+    pub window_errors: Vec<WindowError>,
+    /// Optional monthly spend budget; drives every card's pace percentage.
+    /// Sourced from config, not the API, so it is applied after parsing.
+    pub monthly_budget_usd: Option<f64>,
+}
+
+impl Eq for BifrostSnapshot {}
+
+impl BifrostSnapshot {
+    pub fn window(&self, period: &str) -> Option<&WindowUsage> {
+        self.windows.iter().find(|w| w.period == period)
+    }
+
+    pub fn window_error(&self, period: &str) -> Option<&WindowError> {
+        self.window_errors.iter().find(|e| e.period == period)
+    }
+
+    /// The headline spend — the 30-day window the bar, gauge and budget
+    /// percentage all read.
+    pub fn headline_cost_usd(&self) -> Option<f64> {
+        self.window("30d").map(|w| w.cost_usd)
+    }
+
+    /// Combine the per-period reads into one snapshot. Every window stands on
+    /// its own: a failed or malformed window is recorded as an error and the
+    /// rest survive. Only when nothing succeeded does the whole read fail,
+    /// surfacing the first error so the frontend shows a failed entry rather
+    /// than an empty card set.
+    pub fn build(results: Vec<(&'static str, Result<UsageData>)>) -> Result<Self> {
+        let mut windows = Vec::new();
+        let mut window_errors = Vec::new();
+        let mut errors: Vec<AppError> = Vec::new();
+        // Identity anchor — key fields plus `data_since`, preferring the
+        // headline 30-day body but taking whichever window answered.
+        let mut anchor: Option<(String, String, DateTime<Utc>)> = None;
+
+        for (period, result) in results {
+            let period = period.to_string();
+            match result {
+                Err(e) => {
+                    window_errors.push(WindowError {
+                        period,
+                        error: e.user_message(),
+                    });
+                    errors.push(e);
+                }
+                Ok(data) => match parse_data_since(&data.data_since) {
+                    Err(e) => {
+                        window_errors.push(WindowError {
+                            period,
+                            error: e.user_message(),
+                        });
+                        errors.push(e);
+                    }
+                    Ok(data_since) => {
+                        let prefer = anchor.is_none() || data.period == "30d";
+                        let identity = (data.key_name.clone(), data.key_id.clone(), data_since);
+                        match WindowUsage::parse(data) {
+                            Ok(window) => {
+                                if prefer {
+                                    anchor = Some(identity);
+                                }
+                                windows.push(window);
+                            }
+                            Err(e) => {
+                                window_errors.push(WindowError {
+                                    period,
+                                    error: e.user_message(),
+                                });
+                                errors.push(e);
+                            }
+                        }
+                    }
+                },
+            }
+        }
+
+        let (key_name, key_id, data_since) = match anchor {
+            Some(anchor) => anchor,
+            None => return Err(errors.into_iter().next().unwrap_or_else(|| {
+                AppError::Other("bifrost: no window succeeded".into())
+            })),
+        };
+        let reset_at = if windows.iter().any(|w| w.period == "30d") {
+            Some(data_since + chrono::Duration::days(30))
+        } else {
+            None
+        };
+        Ok(Self {
+            key_name,
+            key_id,
+            reset_at,
+            windows,
+            window_errors,
+            monthly_budget_usd: None,
+        })
+    }
+}
+
+fn parse_data_since(raw: &str) -> Result<DateTime<Utc>> {
+    DateTime::parse_from_str(raw, "%Y-%m-%d %H:%M:%S%.f%:z")
+        .map(|dt| dt.with_timezone(&Utc))
+        .map_err(|e| AppError::Schema(format!("bifrost data_since: {e}")))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn body(period: &str) -> UsageData {
+        UsageData {
+            key_name: "Gery".into(),
+            key_id: "someKeyHere".into(),
+            period: period.into(),
+            data_since: "2026-08-17 03:16:31.604994215+00:00".into(),
+            requests: 930,
+            tokens_in: 89293283,
+            tokens_out: 670148,
+            cost_usd: 4.0946,
+            models_used: 3,
+        }
+    }
+
+    fn ok_all() -> Vec<(&'static str, Result<UsageData>)> {
+        PERIODS
+            .map(|period| (period, Ok(body(period))))
+            .into_iter()
+            .collect()
+    }
+
+    #[test]
+    fn builds_three_windows_in_display_order() {
+        let snap = BifrostSnapshot::build(ok_all()).unwrap();
+        assert_eq!(snap.key_name, "Gery");
+        assert_eq!(
+            snap.windows.iter().map(|w| w.period.as_str()).collect::<Vec<_>>(),
+            vec!["1d", "7d", "30d"]
+        );
+        assert!(snap.window_errors.is_empty());
+        assert_eq!(snap.window("30d").unwrap().cost_usd, 4.0946);
+        assert_eq!(snap.headline_cost_usd(), Some(4.0946));
+        // 2026-08-17 → reset at 2026-09-16 (data_since + 30 days).
+        use chrono::Datelike;
+        let reset = snap.reset_at.unwrap();
+        assert_eq!((reset.year(), reset.month(), reset.day()), (2026, 9, 16));
+    }
+
+    #[test]
+    fn december_rolls_over_to_january() {
+        let mut data = body("30d");
+        data.data_since = "2026-12-31 23:00:00.000000000+00:00".into();
+        let snap = BifrostSnapshot::build(vec![("30d", Ok(data))]).unwrap();
+        use chrono::Datelike;
+        let reset = snap.reset_at.unwrap();
+        assert_eq!((reset.year(), reset.month(), reset.day()), (2027, 1, 30));
+    }
+
+    #[test]
+    fn a_failed_window_keeps_the_rest() {
+        let mut results = ok_all();
+        results[0] = ("1d", Err(AppError::Http {
+            status: 401,
+            body: "invalid key".into(),
+        }));
+        let snap = BifrostSnapshot::build(results).unwrap();
+        assert_eq!(snap.windows.len(), 2);
+        assert_eq!(snap.window("1d"), None);
+        assert_eq!(snap.headline_cost_usd(), Some(4.0946));
+        let error = snap.window_error("1d").unwrap();
+        assert_eq!(error.period, "1d");
+        // Auth failures never leak the response body into the panel.
+        assert!(!error.error.contains("invalid key"));
+    }
+
+    #[test]
+    fn a_failed_headline_still_anchors_on_who_answered() {
+        let mut results = ok_all();
+        results[2] = ("30d", Err(AppError::Http {
+            status: 500,
+            body: "boom".into(),
+        }));
+        let snap = BifrostSnapshot::build(results).unwrap();
+        assert_eq!(snap.key_name, "Gery");
+        assert!(snap.reset_at.is_none());
+        assert_eq!(snap.headline_cost_usd(), None);
+    }
+
+    #[test]
+    fn a_malformed_cost_becomes_a_window_error_not_a_failure() {
+        let mut data = body("7d");
+        data.cost_usd = f64::NAN;
+        let results = vec![
+            ("1d", Ok(body("1d"))),
+            ("7d", Ok(data)),
+            ("30d", Ok(body("30d"))),
+        ];
+        let snap = BifrostSnapshot::build(results).unwrap();
+        assert!(snap.window("7d").is_none());
+        assert_eq!(snap.window_errors.len(), 1);
+        assert_eq!(snap.headline_cost_usd(), Some(4.0946));
+    }
+
+    #[test]
+    fn nothing_succeeding_surfaces_the_first_error() {
+        let results: Vec<(&'static str, Result<UsageData>)> = PERIODS
+            .map(|period| {
+                (
+                    period,
+                    Err(AppError::Http { status: 401, body: "nope".into() }),
+                )
+            })
+            .into_iter()
+            .collect();
+        let err = BifrostSnapshot::build(results).unwrap_err();
+        assert!(matches!(err, AppError::Http { status: 401, .. }));
+    }
+}
