diff --git a/src/bifrost/types.rs b/src/bifrost/types.rs
new file mode 100644
index 0000000..8160023
--- /dev/null
+++ b/src/bifrost/types.rs
@@ -0,0 +1,114 @@
+//! Bifrost usage response types and snapshot conversion.
+
+use chrono::{DateTime, Utc};
+use serde::{Deserialize, Serialize};
+
+use crate::error::{AppError, Result};
+use crate::usage::finite_amount;
+
+/// Raw body returned by `{base_url}/usage?period=30d`.
+#[derive(Debug, Clone, Deserialize)]
+pub struct UsageData {
+    pub key_name: String,
+    pub key_id: String,
+    pub period: String,
+    #[serde(rename = "data_since")]
+    pub data_since: String,
+    pub requests: u64,
+    pub tokens_in: u64,
+    pub tokens_out: u64,
+    pub cost_usd: f64,
+    pub models_used: u64,
+}
+
+/// Parsed, machine-readable Bifrost snapshot surfaced to every frontend.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct BifrostSnapshot {
+    pub key_name: String,
+    pub key_id: String,
+    pub period: String,
+    pub data_since: DateTime<Utc>,
+    pub requests: u64,
+    pub tokens_in: u64,
+    pub tokens_out: u64,
+    pub cost_usd: f64,
+    pub models_used: u64,
+    /// `data_since` + 30 days — the rolling 30-day window reset.
+    pub reset_at: DateTime<Utc>,
+    /// Optional monthly spend budget; drives the headline percentage. Sourced
+    /// from config, not the API, so it is applied after parsing.
+    pub monthly_budget_usd: Option<f64>,
+}
+
+impl Eq for BifrostSnapshot {}
+
+impl BifrostSnapshot {
+    pub fn parse(data: UsageData) -> Result<Self> {
+        let data_since = DateTime::parse_from_str(
+            &data.data_since,
+            "%Y-%m-%d %H:%M:%S%.f%:z",
+        )
+        .map_err(|e| AppError::Schema(format!("bifrost data_since: {e}")))?
+        .with_timezone(&Utc);
+        let reset_at = data_since + chrono::Duration::days(30);
+        Ok(Self {
+            key_name: data.key_name,
+            key_id: data.key_id,
+            period: data.period,
+            data_since,
+            requests: data.requests,
+            tokens_in: data.tokens_in,
+            tokens_out: data.tokens_out,
+            cost_usd: finite_amount("bifrost", "cost_usd", data.cost_usd)?,
+            models_used: data.models_used,
+            reset_at,
+            monthly_budget_usd: None,
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use chrono::Datelike;
+
+    fn sample() -> UsageData {
+        UsageData {
+            key_name: "Gery".into(),
+            key_id: "someKeyHere".into(),
+            period: "30d".into(),
+            data_since: "2026-08-17 03:16:31.604994215+00:00".into(),
+            requests: 930,
+            tokens_in: 89293283,
+            tokens_out: 670148,
+            cost_usd: 4.0946,
+            models_used: 3,
+        }
+    }
+
+    #[test]
+    fn parses_the_documented_sample_and_resets_30d_later() {
+        let snap = BifrostSnapshot::parse(sample()).unwrap();
+        assert_eq!(snap.key_name, "Gery");
+        assert_eq!(snap.requests, 930);
+        assert_eq!(snap.tokens_in, 89293283);
+        assert_eq!(snap.cost_usd, 4.0946);
+        assert_eq!(snap.models_used, 3);
+        // 2026-08-17 → reset at 2026-09-16 (data_since + 30 days).
+        assert_eq!(snap.reset_at.year(), 2026);
+        assert_eq!(snap.reset_at.month(), 9);
+        assert_eq!(snap.reset_at.day(), 16);
+    }
+
+    #[test]
+    fn december_rolls_over_to_january() {
+        let data = UsageData {
+            data_since: "2026-12-31 23:00:00.000000000+00:00".into(),
+            ..sample()
+        };
+        let snap = BifrostSnapshot::parse(data).unwrap();
+        assert_eq!(snap.reset_at.year(), 2027);
+        assert_eq!(snap.reset_at.month(), 1);
+        assert_eq!(snap.reset_at.day(), 30);
+    }
+}
