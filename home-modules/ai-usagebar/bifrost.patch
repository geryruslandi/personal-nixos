+                p,
+                severity_for(p as i32),
+                format!("${:.2} of ${:.2} used", s.cost_usd, b),
+            )
+        }
+        _ => (0, PaceSeverity::Low, format!("${:.2} spent", s.cost_usd)),
+    };
+    let mut v = SectionBuilder::new(vec![
+        Section::Title {
+            left: format!(
+                "Bifrost · {}",
+                crate::display::sanitize_untrusted_field(&s.key_name)
+            ),
+            right: None,
+        },
+        Section::Spacer,
+    ]);
+    v.push_metric(
+        Section::Metric {
+            label: "Monthly cost".into(),
+            pct,
+            severity,
+            value_label: format!("${:.2}", s.cost_usd),
+            footnote,
+        },
+        Some(s.reset_at),
+    );
+    v.push(Section::Spacer);
+    v.push(Section::Text {
+        label: "Requests".into(),
+        value: s.requests.to_string(),
+    });
+    v.push(Section::Text {
+        label: "Tokens in".into(),
