+fn bifrost_sections(s: &crate::usage::BifrostSnapshot, _now: DateTime<Utc>) -> SectionBuilder {
+    let budget = s.monthly_budget_usd;
+    // One capsule per rolling window. With a budget set, each card paces its
+    // window against that window's share of the month (budget × days / 30), so
+    // a fast burn shows on the 1d gauge long before the month catches up. The
+    // 30d card is the headline: it reads the full budget directly and carries
+    // the rolling reset; the shorter windows never reset, so they carry no
+    // clock. Without a budget there is no quota to pace against — the cards
+    // stay Low and speak in dollars only.
+    let card = |period: &str, cost: f64| -> Section {
+        let headline = period == "30d";
+        let (pct, footnote) = match budget {
+            Some(b) if b > 0.0 => {
+                let cap = if headline {
+                    b
+                } else {
+                    b * crate::bifrost::types::period_days(period) / 30.0
+                };
+                let p = ((cost / cap) * 100.0).clamp(0.0, 100.0).round() as u16;
+                (
+                    p,
+                    if headline {
+                        format!("${cost:.2} of ${b:.2} used")
+                    } else {
+                        format!("${cost:.2} of ${cap:.2} pace")
+                    },
+                )
+            }
+            _ => (0, format!("${cost:.2} spent")),
+        };
+        Section::Metric {
+            label: format!("{period} cost"),
+            pct,
+            severity: severity_for(pct as i32),
+            value_label: format!("${cost:.2}"),
+            footnote,
+        }
+    };
+    let key_name = crate::display::sanitize_untrusted_field(&s.key_name);
+    let mut v = SectionBuilder::new(vec![
+        Section::Title {
+            left: if key_name.is_empty() {
+                "Bifrost".into()
+            } else {
+                format!("Bifrost · {key_name}")
+            },
+            right: None,
+        },
+        Section::Spacer,
+    ]);
+    for period in crate::bifrost::types::PERIODS {
+        if let Some(w) = s.window(period) {
+            let reset = if period == "30d" { s.reset_at } else { None };
+            v.push_metric(card(period, w.cost_usd), reset);
+        } else if s.window_error(period).is_some() {
+            // The window keeps its slot as a bare "unavailable" row, so a
+            // missing card is named rather than silently dropped. Deliberately
+            // not the error text: a value that reads as an error would make
+            // the Noctalia plugin withhold every capsule over one flaky
+            // window (see shared.luau's warning()).
+            v.push(Section::Text {
+                label: format!("{period} cost"),
+                value: "unavailable".into(),
+            });
+        }
+    }
+    v
+}
