+async fn bifrost_output(cli: &Cli, config: &Config) -> Result<WaybarOutput> {
+    let api_key = crate::config::resolve_api_key(
+        "Bifrost",
+        &config.bifrost.api_key_env,
+        config.bifrost.api_key.as_deref(),
+    )?;
+    let base_url = config.bifrost.base_url.clone().ok_or_else(|| {
+        crate::error::AppError::Other("bifrost.base_url is required".into())
+    })?;
+    let client = http_client()?;
+    let cache = vendor_cache(cli, "bifrost")?;
+    let endpoints = crate::bifrost::fetch::Endpoints::from_base(&base_url);
+    let outcome = match crate::bifrost::fetch::fetch_snapshot(
+        &client,
+        &api_key,
+        &cache,
+        &endpoints,
+        DEFAULT_TTL,
+        config.bifrost.monthly_budget_usd,
+    )
+    .await
+    {
+        Ok(outcome) => outcome,
+        Err(error) if error.is_transient() => {
+            return Ok(WaybarOutput::loading(cli.icon.as_deref()));
+        }
+        Err(error) => return Err(error),
+    };
+    let snapshot = outcome.snapshot.clone();
+    let vendor_outcome: VendorOutcome = outcome.into();
+    Ok(crate::bifrost::vendor::render(
+        &vendor_outcome,
+        &snapshot,
+        &theme_from_cli(cli),
+        &RenderOpts::from_cli(cli),
+        Utc::now(),
+    ))
+}
