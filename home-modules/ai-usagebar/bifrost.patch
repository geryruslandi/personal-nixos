index 0000000..7dc7f00
--- /dev/null
+++ b/src/bifrost/fetch.rs
@@ -0,0 +1,263 @@
+//! Bifrost fetch — reads the rolling-window usage aggregates from
+//! `{base_url}/usage?period=Xd` (1d, 7d, 30d) under the shared cache + flock
+//! primitives.
+//!
+//! Every window requests the same endpoint; only the `period` query parameter
+//! differs, and the three reads run concurrently. The windows succeed
+//! independently — one flaky period doesn't blank the others — but if nothing
+//! succeeds the read surfaces an error rather than silently serving a stale
+//! cache, so the frontend always shows a failed entry instead of
+//! plausible-but-stale numbers.
+
+use std::time::Duration;
+
+use crate::cache::{Cache, acquire_lock_async};
+use crate::error::{AppError, Result};
+use crate::vendor::{MAX_BODY_BYTES, read_body_capped};
+
+use super::types::{BifrostSnapshot, PERIODS, UsageData};
+
+const HTTP_TIMEOUT: Duration = Duration::from_secs(10);
+const LOCK_TIMEOUT: Duration = Duration::from_secs(15);
+
+#[derive(Debug, Clone)]
+pub struct Endpoints {
+    /// One URL per rolling window, in display order. The same endpoint, only
+    /// `period` changes.
+    pub usage: Vec<(&'static str, String)>,
+}
+
+impl Endpoints {
+    /// Build the usage endpoints from a user-supplied base URL.
+    pub fn from_base(base: &str) -> Self {
+        let base = base.trim_end_matches('/');
+        Self {
+            usage: PERIODS
+                .map(|period| (period, format!("{base}/usage?period={period}")))
+                .into_iter()
+                .collect(),
+        }
+    }
+
+    pub fn url(&self, period: &str) -> &str {
+        self.usage
+            .iter()
+            .find(|(p, _)| *p == period)
+            .map(|(_, url)| url.as_str())
+            .unwrap_or_default()
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct FetchOutcome {
+    pub snapshot: BifrostSnapshot,
+    pub stale: bool,
+    pub last_error: Option<(u16, String)>,
+    pub cache_age: Option<Duration>,
+}
+
+pub async fn fetch_snapshot(
+    client: &reqwest::Client,
+    api_key: &str,
+    cache: &Cache,
+    endpoints: &Endpoints,
+    cache_ttl: Duration,
+    budget: Option<f64>,
+) -> Result<FetchOutcome> {
+    cache.ensure_dir()?;
+    let _lock = acquire_lock_async(&cache.lock_path(), LOCK_TIMEOUT).await?;
+
+    if let Some(bytes) = cache.fresh_payload(cache_ttl)?
+        && let Ok(mut outcome) = reuse_cache(&bytes, cache)
+    {
+        outcome.snapshot.monthly_budget_usd = budget;
+        return Ok(outcome);
+    }
+
+    let (a, b, c) = tokio::join!(
+        fetch_live(client, api_key, endpoints.url(PERIODS[0])),
+        fetch_live(client, api_key, endpoints.url(PERIODS[1])),
+        fetch_live(client, api_key, endpoints.url(PERIODS[2])),
+    );
+    let results = vec![(PERIODS[0], a), (PERIODS[1], b), (PERIODS[2], c)];
+
+    match BifrostSnapshot::build(results) {
+        Ok(mut snap) => {
+            snap.monthly_budget_usd = budget;
+            let bytes = serde_json::to_vec(&snap)?;
+            cache.write_payload(&bytes)?;
+            Ok(FetchOutcome {
+                snapshot: snap,
+                stale: false,
+                last_error: None,
+                cache_age: Some(Duration::ZERO),
+            })
+        }
+        // Nothing succeeded: surface the first error so the read reads as an
+        // error entry, never as silently-stale cached data.
+        Err(e) => {
+            cache.mark_stale();
+            cache.write_last_error(0, &e.to_string());
+            Err(e)
+        }
+    }
+}
+
+fn reuse_cache(bytes: &[u8], cache: &Cache) -> Result<FetchOutcome> {
+    let snap: BifrostSnapshot = serde_json::from_slice(bytes)
+        .map_err(|e| AppError::Schema(format!("bifrost cache: {e}")))?;
+    Ok(FetchOutcome {
+        snapshot: snap,
+        stale: false,
+        last_error: cache.read_last_error(),
+        cache_age: cache.payload_age(),
+    })
+}
+
+async fn fetch_live(
+    client: &reqwest::Client,
+    api_key: &str,
+    url: &str,
+) -> Result<UsageData> {
+    let resp = tokio::time::timeout(
+        HTTP_TIMEOUT,
+        client
+            .get(url)
+            .header("x-bf-vk", api_key)
+            .header("Accept", "application/json")
+            .send(),
+    )
+    .await
+    .map_err(|_| AppError::Transport(format!("bifrost timeout: {url}")))??;
+
+    let status = resp.status();
+    let bytes = read_body_capped(resp, MAX_BODY_BYTES).await?;
+
+    // Any non-2xx is an error. The body is truncated like every other string
+    // that reaches the screen so a leaky endpoint can't flood the bar.
+    if !status.is_success() {
+        let body = String::from_utf8_lossy(&bytes).chars().take(200).collect();
+        return Err(AppError::Http {
+            status: status.as_u16(),
+            body,
+        });
+    }
+
+    serde_json::from_slice(&bytes).map_err(|e| AppError::Schema(format!("bifrost {url}: {e}")))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use tempfile::TempDir;
+
+    fn cache_fixture() -> (TempDir, Cache) {
+        let td = TempDir::new().unwrap();
+        let cache = Cache::at(td.path().join("bifrost"));
+        cache.ensure_dir().unwrap();
+        (td, cache)
+    }
+
+    fn sample_body(period: &str, cost: &str) -> String {
+        format!(
+            r#"{{"key_name":"Gery","key_id":"someKeyHere","period":"{period}",
+                "data_since":"2026-08-17 03:16:31.604994215+00:00",
+                "requests":930,"tokens_in":89293283,"tokens_out":670148,
+                "cost_usd":{cost},"models_used":3}}"#
+        )
+    }
+
+    #[tokio::test]
+    async fn live_fetch_parses_the_documented_sample() {
+        let mut server = mockito::Server::new_async().await;
+        for period in PERIODS {
+            server
+                .mock("GET", format!("/usage?period={period}").as_str())
+                .match_header("x-bf-vk", mockito::Matcher::Any)
+                .with_status(200)
+                .with_body(sample_body(period, "4.0946"))
+                .create_async()
+                .await;
+        }
+
+        let (_td, cache) = cache_fixture();
+        let client = reqwest::Client::new();
+        let endpoints = Endpoints::from_base(&format!("{}/", server.url()));
+        let out = fetch_snapshot(
+            &client,
+            "bf-secret",
+            &cache,
+            &endpoints,
+            Duration::from_secs(0),
+            Some(10.0),
+        )
+        .await
+        .unwrap();
+        assert_eq!(out.snapshot.windows.len(), 3);
+        assert_eq!(out.snapshot.headline_cost_usd(), Some(4.0946));
+        assert_eq!(out.snapshot.monthly_budget_usd, Some(10.0));
+        assert!(!out.stale);
+    }
+
+    #[tokio::test]
+    async fn one_failed_period_keeps_the_other_two() {
+        let mut server = mockito::Server::new_async().await;
+        for period in PERIODS {
+            let (status, body) = if period == "1d" {
+                (401, r#"{"error":"invalid key"}"#.to_string())
+            } else {
+                (200, sample_body(period, "4.0946"))
+            };
+            server
+                .mock("GET", format!("/usage?period={period}").as_str())
+                .with_status(status)
+                .with_body(body)
+                .create_async()
+                .await;
+        }
+
+        let (_td, cache) = cache_fixture();
+        let client = reqwest::Client::new();
+        let endpoints = Endpoints::from_base(&format!("{}/", server.url()));
+        let out = fetch_snapshot(
+            &client,
+            "bf-secret",
+            &cache,
+            &endpoints,
+            Duration::from_secs(0),
+            None,
+        )
+        .await
+        .unwrap();
+        assert_eq!(out.snapshot.windows.len(), 2);
+        assert_eq!(out.snapshot.window_errors.len(), 1);
+        assert_eq!(out.snapshot.window_errors[0].period, "1d");
+    }
+
+    #[tokio::test]
+    async fn every_period_failing_is_returned_as_an_error_not_stale_cache() {
+        let mut server = mockito::Server::new_async().await;
+        for period in PERIODS {
+            server
+                .mock("GET", format!("/usage?period={period}").as_str())
+                .with_status(401)
+                .with_body(r#"{"error":"invalid key"}"#)
+                .create_async()
+                .await;
+        }
+
+        let (_td, cache) = cache_fixture();
+        let client = reqwest::Client::new();
+        let endpoints = Endpoints::from_base(&format!("{}/", server.url()));
+        let result = fetch_snapshot(
+            &client,
+            "bf-secret",
+            &cache,
+            &endpoints,
+            Duration::from_secs(0),
+            None,
+        )
+        .await;
+        assert!(result.is_err(), "expected an error for non-200, got {result:?}");
+    }
+}
