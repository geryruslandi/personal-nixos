+//! Bifrost renderer — bar text + Waybar output. The Noctalia plugin consumes
+//! the `--json` projection (built from the snapshot via `tui::panels`), so this
+//! only backs the Waybar widget path. Everything here reads the headline
+//! 30-day window; the per-window cards live in the panel sections.
+
+use chrono::DateTime;
+use chrono::Utc;
+
+use crate::pacing::PaceSeverity;
+use crate::pango::severity_for;
+use crate::theme::Theme;
+use crate::usage::BifrostSnapshot;
+use crate::vendor::{RenderOpts, VendorOutcome};
+use crate::waybar::{Class, WaybarOutput};
+
+use super::fetch::FetchOutcome;
+
+pub const DEFAULT_FORMAT: &str = "{bf_cost}";
+
+/// Severity keys on the headline (30-day) spend against the optional monthly
+/// budget, exactly like the `--json` headline: no budget → always Low
+/// (time-windowed, not a quota).
+pub fn severity(snap: &BifrostSnapshot) -> PaceSeverity {
+    match (snap.monthly_budget_usd, snap.headline_cost_usd()) {
+        (Some(b), Some(cost)) if b > 0.0 => {
+            severity_for(((cost / b) * 100.0).clamp(0.0, 100.0) as i32)
+        }
+        _ => PaceSeverity::Low,
+    }
+}
+
+pub fn render(
+    outcome: &VendorOutcome,
+    snap: &BifrostSnapshot,
+    _theme: &Theme,
+    opts: &RenderOpts,
+    _now: DateTime<Utc>,
+) -> WaybarOutput {
+    let class = Class::from(severity(snap));
+    let format = opts
+        .format
+        .clone()
+        .unwrap_or_else(|| DEFAULT_FORMAT.to_string());
+    let values = build_placeholders(snap);
+    let mut text = substitute(&format, &values);
+    if outcome.stale {
+        text.push_str(" ⏸");
+    }
+    WaybarOutput {
+        text,
+        tooltip: format!("Bifrost · {}", values["bf_cost"]),
+        class,
+    }
+}
+
+fn build_placeholders(snap: &BifrostSnapshot) -> std::collections::HashMap<&'static str, String> {
+    let mut map = std::collections::HashMap::new();
+    map.insert("icon", "󰢭".to_string());
+    map.insert("vendor_short", "bf".to_string());
+    let headline = snap.window("30d");
+    let cost = headline
+        .map(|w| format!("${:.2}", w.cost_usd))
+        .unwrap_or_else(|| "—".to_string());
+    map.insert("bf_cost", cost);
+    map.insert(
+        "bf_requests",
+        headline.map(|w| w.requests.to_string()).unwrap_or_default(),
+    );
+    map.insert(
+        "bf_tokens",
+        headline
+            .map(|w| format!("{} in / {} out", w.tokens_in, w.tokens_out))
+            .unwrap_or_default(),
+    );
+    map.insert(
+        "bf_models",
+        headline
+            .map(|w| w.models_used.to_string())
+            .unwrap_or_default(),
+    );
+    map.insert("plan", "Bifrost".to_string());
+    map
+}
+
+fn substitute(format: &str, values: &std::collections::HashMap<&'static str, String>) -> String {
+    let mut out = format.to_string();
+    for (key, value) in values {
+        out = out.replace(&format!("{{{key}}}"), value);
+    }
+    out
+}
+
+impl From<FetchOutcome> for VendorOutcome {
+    fn from(o: FetchOutcome) -> Self {
+        Self {
+            snapshot: crate::usage::VendorSnapshot::Bifrost(o.snapshot),
+            stale: o.stale,
+            last_error: o.last_error,
+            cache_age: o.cache_age,
+        }
+    }
+}
