+    #[test]
+    fn deepseek_peak_hours_follow_weekday_utc_windows() {
+        // Wed 2026-05-20: peak 01:00-04:00 and 06:00-10:00 UTC.
+        assert!(!deepseek_v4_is_peak(utc(2026, 5, 20, 0)));
+        assert!(deepseek_v4_is_peak(utc(2026, 5, 20, 1)));
+        assert!(deepseek_v4_is_peak(utc(2026, 5, 20, 3)));
+        assert!(!deepseek_v4_is_peak(utc(2026, 5, 20, 4)));
+        assert!(!deepseek_v4_is_peak(utc(2026, 5, 20, 5)));
+        assert!(deepseek_v4_is_peak(utc(2026, 5, 20, 6)));
+        assert!(deepseek_v4_is_peak(utc(2026, 5, 20, 9)));
+        assert!(!deepseek_v4_is_peak(utc(2026, 5, 20, 10)));
+        assert!(!deepseek_v4_is_peak(utc(2026, 5, 20, 23)));
+        // Sat 2026-05-23 and Sun 2026-05-24: never peak.
+        assert!(!deepseek_v4_is_peak(utc(2026, 5, 23, 2)));
+        assert!(!deepseek_v4_is_peak(utc(2026, 5, 24, 7)));
+    }
+
+    #[test]
+    fn deepseek_next_boundary_skips_hours_days_and_weekends() {
+        assert_eq!(
+            deepseek_v4_next_boundary(utc(2026, 5, 20, 0)),
+            Some(utc(2026, 5, 20, 1))
+        );
+        assert_eq!(
+            deepseek_v4_next_boundary(utc(2026, 5, 20, 2)),
+            Some(utc(2026, 5, 20, 4))
+        );
+        assert_eq!(
+            deepseek_v4_next_boundary(utc(2026, 5, 20, 11)),
+            Some(utc(2026, 5, 21, 1))
+        );
+        // Fri 11:00 → Mon 01:00, skipping the weekend.
+        assert_eq!(
+            deepseek_v4_next_boundary(utc(2026, 5, 22, 11)),
+            Some(utc(2026, 5, 25, 1))
+        );
+    }
