+/// The DeepSeek V4 peak-hours card opens the report: its schedule governs
+/// what a dollar of usage costs, so it reads ahead of the budget windows.
+fn deepseek_v4_peak_sections(now: DateTime<Utc>) -> Vec<SectionProjection> {
+    let peak = deepseek_v4_is_peak(now);
+    let mut body = vec![
+        "Peak (2× rates): Mon–Fri 01:00–04:00, 06:00–10:00 UTC".into(),
+        format!(
+            "Now: {} ({} local · {} UTC)",
+            if peak { "Peak" } else { "Off-Peak" },
+            now.with_timezone(&chrono::Local).format("%H:%M"),
+            now.format("%H:%M"),
+        ),
+    ];
+    if let Some(next) = deepseek_v4_next_boundary(now) {
+        body.push(format!(
+            "Next: {} in {}",
+            if peak { "off-peak" } else { "peak" },
+            countdown::format(Some(next), now),
+        ));
+    }
+    vec![
+        SectionProjection {
+            section: Section::Spacer,
+            reset_at: None,
+            block_severity: None,
+        },
+        SectionProjection {
+            section: Section::Block {
+                label: "DeepSeek V4 Peak Hours".into(),
+                body,
+            },
+            reset_at: None,
+            block_severity: if peak { Some("critical") } else { Some("low") },
+        },
+        SectionProjection {
+            section: Section::Spacer,
+            reset_at: None,
+            block_severity: None,
+        },
+    ]
+}
+
+/// OpenCode Go charges DeepSeek V4 models at 2× rates during peak hours:
+/// Monday–Friday 01:00–04:00 and 06:00–10:00 UTC. Every other hour, weekends
+/// included, is off-peak. See <https://opencode.ai/docs/go/>.
+fn deepseek_v4_is_peak(now: DateTime<Utc>) -> bool {
+    use chrono::{Datelike, Timelike, Weekday};
+    if matches!(now.weekday(), Weekday::Sat | Weekday::Sun) {
+        return false;
+    }
+    let hour = now.hour();
+    (1..4).contains(&hour) || (6..10).contains(&hour)
+}
+
+/// First peak/off-peak boundary strictly after `now`, scanning day by day so
+/// weekends and past-today hours fall through to the next weekday window.
+fn deepseek_v4_next_boundary(now: DateTime<Utc>) -> Option<DateTime<Utc>> {
+    use chrono::{Datelike, Duration, Weekday};
+    let today = now.date_naive();
+    for offset in 0..8i64 {
+        let date = today.checked_add_signed(Duration::days(offset))?;
+        if matches!(date.weekday(), Weekday::Sat | Weekday::Sun) {
+            continue;
+        }
+        for hour in [1u32, 4, 6, 10] {
+            let boundary = date.and_hms_opt(hour, 0, 0)?.and_utc();
+            if boundary > now {
+                return Some(boundary);
+            }
+        }
+    }
+    None
+}
