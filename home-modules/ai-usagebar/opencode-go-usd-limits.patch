+/// Dollar budget behind each OpenCode Go usage window. The `/usage` endpoint
+/// only reports a percentage, so the USD figures are derived from the plan
+/// limits published at <https://opencode.ai/docs/go/>: $12 per 5-hour rolling
+/// window, $30 weekly, $60 monthly. Unknown plans fall back to percent-only.
+fn opencode_go_window_limit(label: &str) -> Option<f64> {
+    match label {
+        "Rolling" => Some(12.0),
+        "Weekly" => Some(30.0),
+        "Monthly" => Some(60.0),
+        _ => None,
+    }
+}
