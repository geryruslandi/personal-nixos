+    #[test]
+    fn opencode_go_sections_show_usd_usage_against_plan_limits() {
+        let window = |percent: f64| crate::opencode_go::types::Window {
+            status: "ok".into(),
+            percent,
+            resets_at: utc(2026, 5, 23, 20),
+        };
+        let usage = crate::opencode_go::types::Usage {
+            rolling: Some(window(5.0)),
+            weekly: Some(window(50.0)),
+            monthly: Some(window(100.0)),
+        };
+        let sections = sections_for(&ready(VendorSnapshot::OpenCodeGo(usage)), now(), 5);
+        let find = |label: &str| -> (String, String) {
+            sections
+                .iter()
+                .find_map(|s| match s {
+                    Section::Metric {
+                        label: l,
+                        value_label,
+                        footnote,
+                        ..
+                    } if l == label => Some((value_label.clone(), footnote.clone())),
+                    _ => None,
+                })
+                .unwrap_or_else(|| panic!("missing metric {label}"))
+        };
+        // Plan limits per https://opencode.ai/docs/go/: $12 rolling, $30
+        // weekly, $60 monthly; value shows what is left of the budget.
+        assert_eq!(find("Rolling"), ("$11.40".into(), "$0.60 of $12.00 used (5%)".into()));
+        assert_eq!(find("Weekly"), ("$15.00".into(), "$15.00 of $30.00 used (50%)".into()));
+        assert_eq!(find("Monthly"), ("$0.00".into(), "$60.00 of $60.00 used (100%)".into()));
+    }
