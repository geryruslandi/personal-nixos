+    /// Highlight percentage for the OpenRouter bar/severity. When a per-key
+    /// limit is configured on the OpenRouter side, track consumption against
+    /// that limit (treated as the daily budget); otherwise fall back to credit
+    /// consumption.
+    pub fn highlight_pct(&self) -> i32 {
+        match (self.limit, self.limit_remaining) {
+            (Some(limit), Some(remaining)) if limit > 0.0 => {
+                let pct = ((limit - remaining) / limit) * 100.0;
+                pct.clamp(0.0, 100.0) as i32
+            }
+            _ => self.consumed_pct(),
+        }
+    }
 }
 
