{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "model": "personal-deepseek/deepseek-v4-flash",
  "permission": {
    "read": {
      "*": "allow",
      "secrets.nix": "deny"
    },
